PORT=5000
MONGODB_URI=mongodb://localhost:27017/dreamcity
# JWT secret: MUST be a strong random value of at least 32 characters
# (e.g. `openssl rand -hex 32`). The server FAILS CLOSED (refuses to boot) on
# missing, empty, whitespace-only, short, or known-insecure values — see
# backend/config/jwtConfig.js. Never reuse any committed/default string.
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your_google_client_id_here
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Personal Gmail SMTP Configuration (for Trusted Device Workstation Enrollment OTPs)
# Note: Requires Google 2-Step Verification and a 16-character App Password generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-char-google-app-password
SMTP_FROM="PlotPro Security <your-gmail-address@gmail.com>"

# Dedicated 256-bit secret for HMAC-SHA256 OTP hashing (keep separate from JWT_SECRET)
DEVICE_OTP_SECRET=your_secure_256bit_hex_device_otp_secret_here

# ─── Security Test Scripts ─────────────────────────────────────────────────────
# Isolated test database for scripts/testPasswordResetSecurity.js.
# MUST be a disposable database (name must contain "test") — NEVER the app DB.
# If omitted, tests fall back to a self-hosted ephemeral in-memory MongoDB
# (mongodb-memory-server) which is fully isolated by design.
# TEST_MONGODB_URI=mongodb://localhost:27017/plotpro_security_test
